{
  "name": "smarter-shopify",
  "version": "0.1.0",
  "private": true,
  "description": "Smarter Chat for Shopify: an extension-only Shopify app whose theme app extension adds a Smarter chatbot to a store.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarter-sh/smarter-shopify.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "theme-check": "node scripts/theme-check.mjs",
    "embed-version": "node scripts/embed-version.mjs",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write .",
    "dev": "shopify app dev",
    "deploy": "shopify app deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@shopify/cli": "^4.9.3",
    "@shopify/prettier-plugin-liquid": "^1.11.2",
    "@shopify/theme-check-node": "^3.30.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "liquidjs": "^10.30.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "vitest": "5.0.4"
  }
}
